<launch>
  <arg name="contract_root" />
  <arg name="canonical_base_url" default="http://127.0.0.1:8776" />
  <node pkg="ares_r_manipulation_blocks" type="run_block_node.py" name="ares_r_run_block" output="screen">
    <param name="contract_root" value="$(arg contract_root)" />
    <param name="canonical_base_url" value="$(arg canonical_base_url)" />
    <param name="offline_replay" value="false" />
  </node>
</launch>
