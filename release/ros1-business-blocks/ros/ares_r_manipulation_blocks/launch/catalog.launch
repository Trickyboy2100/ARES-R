<launch>
  <arg name="contract_root" />
  <arg name="canonical_base_url" default="" />
  <node pkg="ares_r_manipulation_blocks" type="block_catalog_node.py" name="ares_r_block_catalog" output="screen">
    <param name="contract_root" value="$(arg contract_root)" />
    <param name="canonical_base_url" value="$(arg canonical_base_url)" />
  </node>
</launch>
