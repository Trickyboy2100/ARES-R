+def _arc_length_samples(source, dt, speed, accel, baseline, tracking_budget):
+    import numpy as np
+    q = np.asarray(source, dtype=float)
+    arc = np.r_[0., np.cumsum(np.max(np.abs(np.diff(q, axis=0)), axis=1))]
+    keep = np.r_[True, np.diff(arc) > 1e-14]
+    q, arc = q[keep], arc[keep]
+    length = float(arc[-1])
+    if length <= 1e-12:
+        return baseline
+    velocity, acceleration = min(speed), min(accel)
+    ramp = velocity / acceleration
+    minimum = max(2*ramp, length/velocity+ramp)
+    for count in range(max(2, math.ceil(minimum/dt)), len(baseline)-1):
+        duration = count * dt
+        clock = np.arange(count+1)*dt
+        peak = length/(duration-ramp)
+        progress = np.where(clock<ramp, .5*peak/ramp*clock**2,
+            np.where(clock>duration-ramp, length-.5*peak/ramp*(duration-clock)**2,
+                     peak*(clock-.5*ramp)))
+        candidate = np.column_stack([np.interp(progress,arc,q[:,j]) for j in range(6)]).tolist()
+        candidate[0], candidate[-1] = list(source[0]), list(source[-1])
+        if (not native_move_violations(candidate,dt,speed,accel)
+                and predicted_tracking_gate_deg(candidate,dt)<=tracking_budget):
+            return candidate
+    return baseline
 
