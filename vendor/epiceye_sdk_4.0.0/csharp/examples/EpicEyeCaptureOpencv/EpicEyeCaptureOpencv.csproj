<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="Exists('..\..\SDK\EpicEye.SDK.csproj')" Include="..\..\SDK\EpicEye.SDK.csproj" />
    <PackageReference Condition="!Exists('..\..\SDK\EpicEye.SDK.csproj')" Include="EpicEye.SDK" Version="$(EpicEyeSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.5.3.20211228" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.5.3.20211228" />
    <PackageReference Include="OpenCvSharp4.runtime.ubuntu.18.04-x64" Version="4.5.3.20211228" />
  </ItemGroup>

</Project>
